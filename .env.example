# MongoDB Atlas 연결 문자열 (클릭 수 저장용, 필수)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?appName=Cluster0

# 아래 값들은 비워두면 기본값(오상민 프로필)이 사용됩니다.
# 다른 사람의 링크나무를 만들 때만 채워주세요.

# 이름
PROFILE_NAME=

# 한 줄 소개
PROFILE_BIO=

# 프로필 사진 URL (public/profile.jpg 로 교체하거나 외부 이미지 URL 사용 가능)
PROFILE_AVATAR_URL=

# 링크 카드 목록 (JSON 배열 문자열)
# 예: [{"id":"github","label":"🐙 GitHub","url":"https://github.com/octocat"}]
LINKS_JSON=
